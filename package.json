{
  "name": "lingxiloop",
  "private": true,
  "version": "0.1.0-beta",
  "type": "module",
  "description": "Real-time communication and collaboration for humans and AI agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LingXi-Org/LingxiLoop.git"
  },
  "homepage": "https://github.com/LingXi-Org/LingxiLoop",
  "author": {
    "name": "LingXi-Org"
  },
  "scripts": {
    "deploy": "node deploy/cli.mjs",
    "dev": "vite --port 5180 --strictPort",
    "dev:all": "concurrently -k -n web,api,worker -c blue,magenta,yellow \"npm:dev\" \"npm:server:dev\" \"npm:worker:dev\"",
    "dev:doctor": "cross-env DOTENV_CONFIG_PATH=.env.local node scripts/local-preview-doctor.mjs",
    "predev:preview": "npm run dev:doctor",
    "dev:preview": "cross-env DOTENV_CONFIG_PATH=.env.local NODE_USE_ENV_PROXY=1 concurrently --restart-tries -1 --restart-after 500 -n control,web,api,worker -c green,blue,magenta,yellow \"npm:control:dev\" \"npm:dev\" \"npm:server:dev\" \"npm:worker:dev\"",
    "dev:migrate": "cross-env DOTENV_CONFIG_PATH=.env.local npm run db:migrate",
    "build": "npm run typecheck && vite build",
    "admin:dev": "vite --config vite.admin.config.ts --port 5198 --strictPort",
    "admin:typecheck": "tsc -p tsconfig.admin.json --noEmit",
    "admin:build": "npm run admin:typecheck && vite build --config vite.admin.config.ts",
    "control:dev": "wrangler dev --config workers/control-plane/wrangler.jsonc",
    "control:typecheck": "tsc -p workers/control-plane/tsconfig.json --noEmit",
    "control:test": "vitest run --config workers/control-plane/vitest.config.ts",
    "control:types": "wrangler types --config workers/control-plane/wrangler.jsonc",
    "control:d1:local": "wrangler d1 migrations apply lingxiloop-control-plane --local --config workers/control-plane/wrangler.jsonc",
    "control:d1:remote": "node --max-old-space-size=4096 node_modules/wrangler/bin/wrangler.js d1 migrations apply lingxiloop-control-plane --remote --config workers/control-plane/wrangler.jsonc",
    "control:deploy": "npm run admin:build && wrangler deploy --config workers/control-plane/wrangler.jsonc",
    "preview": "vite preview --host --port 5180",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "server:dev": "tsx watch server/src/bin/web.ts",
    "preserver:dev": "npm run build:slides-editor",
    "server:start": "tsx server/src/bin/web.ts",
    "worker:dev": "tsx watch server/src/bin/worker.ts",
    "worker:start": "tsx server/src/bin/worker.ts",
    "server:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "version:sync": "node scripts/sync-version.mjs --write",
    "version:check": "node scripts/sync-version.mjs --check",
    "lint": "biome lint src vite.config.ts",
    "admin:lint": "biome lint admin vite.admin.config.ts",
    "server:lint": "biome lint server",
    "control:lint": "biome lint workers/control-plane worker-configuration.d.ts",
    "lint:fix": "biome lint --write src vite.config.ts",
    "test": "node scripts/run-tests.mjs web",
    "admin:test": "node scripts/run-tests.mjs admin",
    "server:test": "node scripts/run-tests.mjs server",
    "test:integration": "node server/run-integration-tests.mjs",
    "db:migrate": "tsx server/src/migrate-bin.ts",
    "mvp:up": "docker compose -f docker-compose.mvp.yml up -d --pull always --wait",
    "mvp:down": "docker compose -f docker-compose.mvp.yml down",
    "icons": "node scripts/generate-icons.mjs",
    "verify:visualize": "node scripts/verify-zcode-visualize.mjs",
    "build:visualize-runtime": "node scripts/build-visualize-runtime.mjs",
    "build:slides-editor": "node scripts/build-slides-editor.mjs",
    "prebuild": "npm run verify:visualize && npm run build:visualize-runtime",
    "memory:maintain": "tsx server/src/bin/memory-maintenance.ts"
  },
