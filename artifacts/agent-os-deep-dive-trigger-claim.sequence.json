  "cards": [
    { "dot": "cyan", "title": "触发类型与 lane", "items": ["learner：message / mention；approval：resume；collaboration：handoff / canvas_worker / canvas_summary", "background：routine / memory_synthesis 等；领取顺序 learner(4) > approval(3) > collaboration(2) > background(1)", "同 lane 内再按 priority DESC、created_at ASC；因此它不是简单 FIFO"] },
    { "dot": "violet", "title": "确定性路由优先级", "items": ["handoff target > @all > 显式 @mentions > Agent 自发消息不扩散", "其后是 reply author > 私聊中的第一个 Agent > 配置 leader", "没有 leader 时按 Nova、Forge 回退；整个过程不调用模型做 triage"] },
    { "dot": "rose", "title": "Webhook 幂等与攻击面", "items": ["eventId 对应一条 receipt，payloadHash 必须一致；同 ID 不同 digest 返回 409", "产品请求中的 suppressAgentWake 被忽略，不能由调用方绕过唤醒", "签名校验、频道绑定、成员关系和 teacher room 约束发生在入队前"] },
    { "dot": "emerald", "title": "为什么 receipt 与 work 必须同事务", "items": ["只写 receipt 会吞掉消息；只写 work 会在重试时重复触发", "事务成功后才发布 queued preview，发布失败不会回滚已经耐久的工作", "附件需要摄取时可先创建 knowledge job 并延后 Agent 唤醒"] },
    { "dot": "amber", "title": "双租约解决两个不同问题", "items": ["work lease：只有一个 worker 能对这条工作推进、动作、保存和完成", "session lease：同 company + agent + channel + threadRoot 的会话一次只执行一个 work", "两个租约都为 45 秒；Agent OS 每 5 秒 heartbeat，旧 token 只保存 hash"] },
    { "dot": "orange", "title": "monotonic fence 是最终防线", "items": ["重新领取时 fence+1；所有敏感接口带 workId、fence、lease token", "即使旧 worker 没及时收到取消或网络分区，它的 session save 与 Host Action 也会被新 fence 拒绝", "PUT session 还要求 revision 乐观锁，避免同 fence 的陈旧覆盖"] },
    { "dot": "cyan", "title": "上下文不是一次数据库 JOIN", "items": ["WuKong 同步最多 80 条并推进 Agent 已读；authorizationUserId 必须来自持久的人类发送者", "Prompt 由 persona、能力、角色、策略、日期和记忆组成；知识只在本次 turn 初始检索", "学习/教师上下文可在每个 hop 刷新；审批结果与 Canvas roster/snapshot 同时装载"] },
    { "dot": "slate", "title": "去重边界", "items": ["AgentWorkItem 唯一键：(agent_id, trigger_client_msg_no, reason)", "相同 WuKong clientMsgNo 的安全重放收敛；不同内容复用 nonce 会产生冲突", "runId=workId，后续 event、Host Action、final clientMsgNo 都从这个稳定身份派生"] }
  ]
