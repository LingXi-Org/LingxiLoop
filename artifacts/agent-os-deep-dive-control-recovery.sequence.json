  "cards": [
    { "dot": "cyan", "title": "事件序列与 fence 不冲突", "items": ["每个 fence 的本地 event sequence 被偏移到 (fence-1)×100000 的区间", "数据库唯一键 (run_id, sequence) 阻止同 run 重复事件；runId 始终为 workId", "run.started、input.loaded、knowledge.context.loaded、model.*、ipython.*、approval.pending、run.* 都可审计"] },
    { "dot": "violet", "title": "预览不是第二套消息", "items": ["model.delta 与 activity 允许丢失、重复或晚到，客户端按 run 聚合", "approval/activity 卡可以投影到 WuKong，但聊天正文的最终事实仍只有 LingxiMessageV1", "收到最终权威消息后清理同 run 预览，离线客户端只靠 WuKong 同步也能收敛"] },
    { "dot": "emerald", "title": "Steer 的语义", "items": ["clientRequestId 使提交幂等；文本进入 work 的耐久 steer queue", "heartbeat 返回所有待处理项，runtime 去重并在下一模型 hop 前优先注入", "Steer 不打断正在执行的 cell，也不重写已经发生的模型历史"] },
    { "dot": "rose", "title": "Stop 的语义与当前竞态窗口", "items": ["Stop 先设置 cancel_requested_at；下一 heartbeat 使 runtime abort model/cell 并发出 run.cancelled", "Host Action 端点要求 actionable lease，因此取消一落库，新的产品副作用即被拒绝", "当前 final-message 端点只校验 live lease、不检查 cancel_requested_at；在 5 秒 heartbeat 前存在极短的最终消息竞态窗口"] },
    { "dot": "amber", "title": "协作式抢占与强制接管", "items": ["watchdog 发现高 lane 等待超过默认 120 秒，给低 lane active work 设置 preempt_requested_at", "worker heartbeat 后先保存 session 再 yield；work 延迟 1 秒回队、preemptions+1、fence+1", "30 秒内未 yield，watchdog 强制 requeue 与 fence；旧 worker 的后续写入全部失效"] },
    { "dot": "orange", "title": "崩溃恢复的幂等层", "items": ["work：稳定 workId + lease/fence；session：revision + appliedWorkIds(最多200)", "Host Action：runId:cellId:callIndex ledger + 领域 sink 幂等；最终消息：agent-{workId}", "这些身份分别处理重新领取、输入重放、cell 后崩溃和最终消息重试，不能互相替代"] },
    { "dot": "rose", "title": "LLM 记账的当前崩溃窗口", "items": ["模型 driver 先完成 provider 调用并把 model.completed/failed 作为事件发给 Control Plane", "Control Plane 收到事件时才写 llm_calls；若进程在 provider 返回后、事件提交前崩溃，该次调用可能未记账", "因此现实现是 event-mediated accounting，还没有做到跨崩溃的 provider-call exactly-once ledger"] },
    { "dot": "slate", "title": "故障归类", "items": ["lease lost / stale fence：立即停止，不能提交；preempt：保存后 yield；cancel：中止并终结", "kernel timeout：杀进程并可在后续 hop 重建；model adapter error：记录 diagnostics 并失败", "外部 side effect 后崩溃：重放 pending action，正确性依赖领域 sink 接受同一幂等键"] }
  ]
