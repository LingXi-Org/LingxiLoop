  "cards": [
    {
      "dot": "cyan",
      "title": "运行时与权威状态",
      "items": [
        "Web 与 Worker 同镜像不同进程；Agent OS、Open Notebook 是独立服务边界",
        "WuKongIM 管消息，PostgreSQL 管产品与 Agent，R2 管对象，Redis 只做事件/短期状态"
      ]
    },
    {
      "dot": "violet",
      "title": "Agent 与一致性闭环",
      "items": [
        "模型只见 ipython 与 loop.* SDK；Host 边界重新授权，审批、租约/fence、revision 和幂等键约束副作用",
        "Webhook/工作项事务化；Canvas/Yjs 以 PostgreSQL 为真值并通过 Redis/WS 增量与快照收敛"
      ]
    },
    {
      "dot": "rose",
      "title": "当前边界与约束",
      "items": [
        "v1 数据库仅支持空库 bootstrap，没有在线迁移/升级路径",
        "Engineering Control Plane、计费 Provider 与空的 Boards/Trust 切片仍是契约或延后能力"
      ]
    }
  ]
}
