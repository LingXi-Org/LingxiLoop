  "cards": [
    { "dot": "cyan", "title": "触发是持久化事件，不是长连接调用", "items": ["WuKongIM 先成为消息权威，再以签名 Webhook 通知 Web", "receipt 去重、接收者解析、AgentWorkItem 和 processed_at 位于同一事务", "HTTP 200 只表示触发可靠接收，不等待模型运行"] },
    { "dot": "violet", "title": "不是每条消息都会唤醒每个 Agent", "items": ["接收者由 mention、mentionAll、回复对象、leader 和 handoff 规则计算", "suppressAgentWake 的产品状态消息直接忽略", "知识附件可能先进入摄取作业并延迟 Agent 唤醒"] },
    { "dot": "emerald", "title": "领取由两层租约约束", "items": ["Agent OS 用 service token 轮询，不直接连接产品数据库", "FOR UPDATE SKIP LOCKED 按 lane、priority、created_at 选择工作项", "work lease 与 session lease 同时建立，避免同一会话并行运行"] },
    { "dot": "amber", "title": "fence 用来拒绝迟到执行者", "items": ["每次领取 fence+1，lease token 只以 hash 形式保存", "绝大多数 Host API 都重新检查 work id、fence、token、状态和过期时间", "旧实例即使恢复，也不能保存会话、执行动作或完成工作项"] },
    { "dot": "violet", "title": "上下文有两个权威来源", "items": ["聊天历史由 Web 向 WuKongIM syncMessages，最多读取 80 条", "persona、权限、记忆、知识、学习和 Canvas 状态来自产品控制平面/PostgreSQL", "Agent OS 只接收 Host 固定作用域后的 bounded context"] },
    { "dot": "slate", "title": "Session 是独立的模型历史", "items": ["session key=company+agent+channel+thread，不等同于 WuKong 消息历史", "history、summary、promptContext、appliedWorkIds 与 revision 持久化", "新 work 只追加一次，防止重新领取时重复注入触发上下文"] },
    { "dot": "orange", "title": "模型只拥有一个工具", "items": ["MODEL_TOOLS 被冻结为仅含 ipython，参数也严格只有 code", "Chat Completions 流式输出；LingxiLoop 自己维护历史，不使用 Provider thread", "一轮最多执行 12 个 model hops，必要时进行上下文压缩"] },
    { "dot": "cyan", "title": "预览流和最终消息不是一回事", "items": ["run.started、model.delta、run.completed 被映射为 stream.open/delta/close", "这些事件是临时传输状态，不进入权威会话历史", "最终正文稍后通过 /messages 写入 WuKongIM"] },
    { "dot": "rose", "title": "Kernel 受到本地隔离约束", "items": ["Python 以 -I 启动，每个 session 使用独立 Agent Home", "默认禁止直接网络、跨 Agent 文件读取、外部写入和子进程", "输出有大小上限；超时会杀死并重建 Kernel"] },
    { "dot": "rose", "title": "loop.* 只是 Host Bridge 客户端", "items": ["Python 内没有产品实现；loop.* 发出 NDJSON host_call 并等待 host_result", "idempotencyKey 精确等于 workId:cellId:callIndex", "Agent OS 把调用转交 Web，Kernel 自身不能决定权限"] },
    { "dot": "amber", "title": "Host Action 执行顺序", "items": ["先锁 work/action，复核 lease 和 cancel，再查询可重放 ledger", "随后检查 Agent capability、执行角色及持久人类主体的当前产品权限", "获批动作执行领域适配器，完成后保存 succeeded/failed 结果"] },
    { "dot": "orange", "title": "审批会结束当前工作项", "items": ["敏感动作写 approvals 与 awaiting_approval，并返回 approval id", "Runtime 保存 session、发出 approval.pending，然后把当前 work 标记 completed", "审批决议会创建新的 resume 工作项，不在原租约中无限等待"] },
    { "dot": "slate", "title": "模型循环与租约循环并行存在", "items": ["heartbeat 默认每 5 秒运行，数据库租约为 45 秒", "cancel 立即中止；preempt 保存 session 后 yield 并 fence+1 重新排队", "steer 文本进入下一 model hop 的最高优先级 user 输入"] },
    { "dot": "cyan", "title": "最终回复不是普通 Host Action", "items": ["Runtime 使用专用 /work/:id/messages 端点，仍必须持有有效租约", "消息使用稳定 clientMsgNo=agent-{workId}，由 Web 以 Agent 身份写入 WuKongIM", "正文提交后才保存 session、发 run.completed 并完成 work"] },
    { "dot": "emerald", "title": "Session 保存采用乐观并发", "items": ["PUT session 同时核对 work lease、session lease 和固定 session identity", "INSERT 仅允许 expected revision=0；更新使用 WHERE revision=expected", "CAS 成功后 revision+1，冲突返回 409 而不是覆盖其他执行"] },
    { "dot": "rose", "title": "主要失败恢复点", "items": ["Webhook 重复：receipt + AgentWorkItem 唯一键去重", "Agent 失联：lease 过期后重领；fence 拒绝迟到提交", "Host Action 重试：账本重放；Kernel 超时：重启并把错误作为 tool output"] },
    { "dot": "slate", "title": "代码证据入口", "items": ["server/src/im/webhook.ts、webhook-application.ts、webhook-repository.ts", "server/src/agent-os/control-plane.ts、service.ts、runtime.ts、host-adapter.ts", "server/src/agent-os/model-driver.ts、tool.ts、kernel-manager.ts、host-action-application.ts、authorization.ts", "server/agent-os/kernel_runner.py"] }
  ]
}
