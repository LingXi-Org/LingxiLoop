  "cards": [
    { "dot": "violet", "title": "Canvas 是共享状态协议，不是共享执行器", "items": ["workspace、assignment DAG、frames、reports 和状态在 PostgreSQL 中共享", "每个 Agent 仍使用自己的 session key、lease、IPython kernel、globals 与 Agent Home", "Agent 间协作只能通过持久 Canvas 状态、WuKong 消息或显式 handoff，不共享进程内内存"] },
    { "dot": "cyan", "title": "DAG 约束", "items": ["创建 assignment 时验证依赖存在、无环和 workspace 归属", "只有全部依赖完成的 assignment 会生成 canvas_worker work", "验证者必须与 builder 不同；reporter 是最终汇总角色，不代替任务级验证"] },
    { "dot": "emerald", "title": "为什么 worker 不直接发群聊", "items": ["canvas_worker 的 assistant 文本保存在 assignment，runtime 明确抑制普通 conversation reply", "完成条件不是“模型说完成”，而是数据库中存在与 assignment 对应的有效 learning_report_v1", "因此并行 worker 不会在群聊产生多条互相竞争的最终答案"] },
    { "dot": "amber", "title": "report gate", "items": ["报告携带 summary、evidence、artifacts、limitations、nextActions 等结构化事实", "Host Action 校验 workspace/assignment/Agent 身份，并用共享 workspace advisory lock 串行关键更新", "下游任务只消费已经持久化的报告与工件，不依赖上游 Agent 的临时上下文"] },
    { "dot": "orange", "title": "handoff 与 defer_to_canvas", "items": ["普通 chat.handoff 会发送可见消息并为目标 Agent 创建 handoff work", "当产品动作返回 defer_to_canvas，原 runtime 保存 session 并结束，不伪造一个即时聊天答案", "后续由 Canvas DAG 和 reporter 承担交付；这一点把长任务从单 Agent hop loop 中解耦"] },
    { "dot": "rose", "title": "停止语义", "items": ["停止 workspace 会阻止新的任务推进并让 active worker 在租约/取消检查处退出", "Host Action 对 stop 后的 Canvas 动作要求 actionable lease，因此不等待下一模型 hop 才生效", "workspace stopped 时不再创建 canvas_summary，避免用户取消后仍收到迟到汇总"] },
    { "dot": "cyan", "title": "实时展示与权威状态", "items": ["Canvas UI 可通过 Redis/WebSocket 接收状态投影、活动和 frame 更新", "刷新或断线后必须从 PostgreSQL snapshot 重建；实时流不是 DAG 权威", "最终聊天交付仍由 reporter 的单条 WuKongIM 消息完成"] },
    { "dot": "slate", "title": "角色与能力仍经过 Host Bridge", "items": ["coordinator 可规划与分配；specialist 构建；verifier/reporters 的动作表被窄化", "角色不是跨租户授权；每次动作仍检查 company、Agent、human principal、capability 和资源归属", "共享 workspace 锁只解决并发一致性，不替代用户权限和 action idempotency"] }
  ]
