<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG-ONLY network security config. Lives under src/debug/ so it is merged
  ONLY into debug builds — the release (Play Store) build never sees it and
  keeps its default cleartext-blocked posture.

  Allows cleartext HTTP to the local dev server reached from the Android
  emulator (10.0.2.2 is the host-loopback alias) so a debug build baked with
  VITE_LINGXILOOP_API_BASE=http://10.0.2.2:5181 can register push tokens against
  the local server. localhost is included for adb-reverse setups.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
