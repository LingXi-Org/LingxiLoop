DEFINE TABLE open_notebook SCHEMALESS;
DEFINE TABLE command SCHEMALESS;

DEFINE TABLE notebook SCHEMAFULL;
DEFINE FIELD name ON TABLE notebook TYPE string;
DEFINE FIELD description ON TABLE notebook TYPE string DEFAULT '';
DEFINE FIELD archived ON TABLE notebook TYPE bool DEFAULT false;
DEFINE FIELD external_key ON TABLE notebook TYPE string;
DEFINE FIELD last_viewed_at ON TABLE notebook TYPE option<datetime>;
DEFINE FIELD created ON TABLE notebook TYPE datetime DEFAULT time::now();
DEFINE FIELD updated ON TABLE notebook TYPE datetime DEFAULT time::now() VALUE time::now();
DEFINE INDEX idx_notebook_external_key ON TABLE notebook COLUMNS external_key UNIQUE;

DEFINE TABLE source SCHEMAFULL;
DEFINE FIELD asset ON TABLE source FLEXIBLE TYPE option<object>;
DEFINE FIELD title ON TABLE source TYPE option<string>;
DEFINE FIELD topics ON TABLE source TYPE option<array<string>>;
DEFINE FIELD full_text ON TABLE source TYPE option<string>;
DEFINE FIELD command ON TABLE source TYPE option<record<command>>;
DEFINE FIELD rag_state ON TABLE source TYPE option<string>;
DEFINE FIELD external_key ON TABLE source TYPE string;
DEFINE FIELD ingestion_fingerprint ON TABLE source TYPE string;
DEFINE FIELD company_id ON TABLE source TYPE string;
DEFINE FIELD last_viewed_at ON TABLE source TYPE option<datetime>;
DEFINE FIELD created ON TABLE source TYPE datetime DEFAULT time::now();
DEFINE FIELD updated ON TABLE source TYPE datetime DEFAULT time::now() VALUE time::now();
DEFINE INDEX idx_source_external_key ON TABLE source COLUMNS external_key UNIQUE;

DEFINE TABLE source_embedding SCHEMAFULL;
DEFINE FIELD source ON TABLE source_embedding TYPE record<source>;
DEFINE FIELD order ON TABLE source_embedding TYPE int;
DEFINE FIELD content ON TABLE source_embedding TYPE string;
DEFINE FIELD embedding ON TABLE source_embedding TYPE array<float>;

DEFINE TABLE reference TYPE RELATION FROM source TO notebook;
DEFINE EVENT source_delete ON TABLE source WHEN ($after == NONE) THEN {
  DELETE source_embedding WHERE source = $before.id;
};

DEFINE ANALYZER rag_analyzer TOKENIZERS blank,class,camel,punct FILTERS lowercase;
DEFINE INDEX idx_source_title ON TABLE source COLUMNS title SEARCH ANALYZER rag_analyzer BM25 HIGHLIGHTS;
DEFINE INDEX idx_source_full_text ON TABLE source COLUMNS full_text SEARCH ANALYZER rag_analyzer BM25 HIGHLIGHTS;
DEFINE INDEX idx_source_embedding_content ON TABLE source_embedding COLUMNS content SEARCH ANALYZER rag_analyzer BM25 HIGHLIGHTS;

DEFINE FUNCTION fn::scoped_vector_search(
  $query: array<float>, $match_count: int, $min_similarity: float, $source_ids: array<record>
) {
  RETURN SELECT id, source.id AS parent_id, source.title AS title, content,
    [content] AS matches, vector::similarity::cosine(embedding, $query) AS similarity
  FROM source_embedding
  WHERE source.id IN $source_ids AND embedding != NONE
    AND array::len(embedding) = array::len($query)
    AND vector::similarity::cosine(embedding, $query) >= $min_similarity
  ORDER BY similarity DESC LIMIT $match_count;
};

DEFINE FUNCTION fn::scoped_text_search(
  $query: string, $match_count: int, $source_ids: array<record>
) {
  RETURN SELECT id, source.id AS parent_id, source.title AS title, content,
    search::highlight('<b>', '</b>', 1) AS matches, search::score(1) AS relevance
  FROM source_embedding
  WHERE source.id IN $source_ids AND content @1@ $query
  ORDER BY relevance DESC LIMIT $match_count;
};

UPSERT open_notebook:rag_schema SET version = 1, updated = time::now();
