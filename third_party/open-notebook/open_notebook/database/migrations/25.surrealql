-- LingxiLoop production RAG contract.  Keep the migration-24 function
-- signatures for wire compatibility, but make source chunks the only
-- searchable corpus.  Notes and source insights are deliberately impossible
-- to retrieve even if legacy rows remain in the database.

REMOVE FUNCTION IF EXISTS fn::scoped_vector_search;
REMOVE FUNCTION IF EXISTS fn::scoped_text_search;

DEFINE FIELD IF NOT EXISTS rag_state ON TABLE source TYPE option<string>;
DEFINE FIELD IF NOT EXISTS external_key ON TABLE source TYPE option<string>;
DEFINE FIELD IF NOT EXISTS ingestion_fingerprint ON TABLE source TYPE option<string>;
DEFINE INDEX IF NOT EXISTS idx_source_external_key ON TABLE source COLUMNS external_key UNIQUE CONCURRENTLY;

DEFINE FUNCTION fn::scoped_vector_search(
    $query: array<float>,
    $match_count: int,
    $sources: bool,
    $show_notes: bool,
    $min_similarity: float,
    $source_ids: array<record>,
    $note_ids: array<record>
) {
    RETURN IF $sources {(
        SELECT
            id,
            source.id AS parent_id,
            source.title AS title,
            content,
            [content] AS matches,
            vector::similarity::cosine(embedding, $query) AS similarity
        FROM source_embedding
        WHERE source.id IN $source_ids
          AND embedding != NONE
          AND array::len(embedding) = array::len($query)
          AND vector::similarity::cosine(embedding, $query) >= $min_similarity
        ORDER BY similarity DESC
        LIMIT $match_count
    )} ELSE { [] };
};

DEFINE FUNCTION fn::scoped_text_search(
    $query_text: string,
    $match_count: int,
    $sources: bool,
    $show_notes: bool,
    $source_ids: array<record>,
    $note_ids: array<record>
) {
    RETURN IF $sources {(
        SELECT id, source.id AS parent_id, source.title AS title, content,
               [content] AS matches, search::score(1) AS relevance
        FROM source_embedding
        WHERE source.id IN $source_ids AND content @1@ $query_text
        ORDER BY relevance DESC
        LIMIT $match_count
    )} ELSE { [] };
};
