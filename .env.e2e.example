# Only for the disposable local fixture created by e2e/local-api.mjs and e2e/admin/start-control.mjs.
# Copy to .env.e2e.local. Never put product credentials in this file.
E2E_USER_MEMBER_USERNAME=member@e2e.lingxiloop.test
E2E_USER_MEMBER_PASSWORD=Local-E2E-password-0001!
E2E_USER_ADMIN_USERNAME=admin@e2e.lingxiloop.test
E2E_USER_ADMIN_PASSWORD=Local-E2E-password-0001!
E2E_USER_STUDENT_USERNAME=student@e2e.lingxiloop.test
E2E_USER_STUDENT_PASSWORD=Local-E2E-password-0001!
E2E_USER_MANAGER_USERNAME=manager@e2e.lingxiloop.test
E2E_USER_MANAGER_PASSWORD=Local-E2E-password-0001!
E2E_MUTATIONS=1
E2E_ADMIN_FIXTURES=1
E2E_WORKSPACE_NAME=E2E Classroom
E2E_PEER_NAME=E2E student
E2E_GROUP_PEERS=E2E student|E2E admin
# Enable only after providing a real dedicated knowledge service.
E2E_KNOWLEDGE=0
