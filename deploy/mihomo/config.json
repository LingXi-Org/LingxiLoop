{
  "mixed-port": 17890,
  "allow-lan": false,
  "bind-address": "127.0.0.1",
  "mode": "rule",
  "log-level": "silent",
  "ipv6": false,
  "tun": { "enable": false },
  "dns": { "enable": false },
  "profile": { "store-selected": false },
  "proxy-providers": {
    "subscription": { "type": "file", "path": "./provider.json" }
  },
  "proxy-groups": [ { "name": "REGISTRY", "type": "select", "use": ["subscription"] } ],
  "rules": [
    "DOMAIN,ghcr.io,REGISTRY",
    "DOMAIN,pkg-containers.githubusercontent.com,REGISTRY",
    "DOMAIN,npm.pkg.github.com,REGISTRY",
    "DOMAIN,api.github.com,REGISTRY",
    "DOMAIN,github.com,REGISTRY",
    "DOMAIN-SUFFIX,githubusercontent.com,REGISTRY",
    "MATCH,DIRECT"
  ]
}
