# Non-secret settings. Put MIHOMO_SUBSCRIPTION_URL in Sigillo prod, not here.
# The exact approved subscription HTTPS origin must be filled by the operator.
MIHOMO_SUBSCRIPTION_ORIGIN=https://subscription.example.invalid
MIHOMO_BINARY=/usr/local/bin/mihomo
MIHOMO_STATE_DIR=/var/lib/lingxi-mihomo
# Example provider reference (not shell interpolation and not a real credential):
# sigillo://LingxiLoop Control Plane/prod/MIHOMO_SUBSCRIPTION_URL
