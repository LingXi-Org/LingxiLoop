{
  "version": 1,
  "listen": {
    "host": "127.0.0.1",
    "port": 9465
  },
  "stateDirectory": "/var/lib/lingxi-release",
  "tokenFile": "/run/credentials/lingxi-release-host.service/executor-token",
  "dockerBinary": "/usr/bin/docker",
  "drainTimeoutMs": 180000,
  "stopTimeoutSeconds": 150,
  "startupTimeoutMs": 180000,
  "pollIntervalMs": 1000,
  "targets": {
    "main-runtime-a": {
      "adapter": "main-runtime",
      "project": "REPLACE_WITH_CURRENT_COMPOSE_PROJECT",
      "composeFile": "/etc/lingxi-release/runtime/compose.yml",
      "envFile": "/etc/lingxi-release/secrets/runtime.env",
      "databaseOwner": true,
      "migration": {
        "service": "db-migrate",
        "imageService": "lingxiloop"
      },
      "services": {
        "lingxiloop": {
          "role": "web",
          "mounts": []
        },
        "worker": {
          "role": "worker",
          "mounts": [
            {
              "type": "volume",
              "source": "REPLACE_WITH_EXISTING_HOMES_VOLUME",
              "target": "/var/lib/lingxios/homes",
              "readOnly": false
            }
          ]
        }
      },
      "readinessUrl": "https://REPLACE_WITH_PRIVATE_TRUSTED_READINESS_ORIGIN/api/readyz",
      "qualifiedRollingContracts": [],
      "controls": {
        "state": {
          "argv": [
            "/usr/bin/node",
            "--experimental-sqlite",
            "/opt/lingxi-release/current/scripts/release-host/local-control.mjs",
            "/etc/lingxi-release/policy.json",
            "state"
          ],
          "timeoutMs": 30000
        },
        "barrier": {
          "argv": [
            "/usr/bin/node",
            "--experimental-sqlite",
            "/opt/lingxi-release/current/scripts/release-host/local-control.mjs",
            "/etc/lingxi-release/policy.json",
            "barrier"
          ],
          "timeoutMs": 30000
        },
        "readiness": {
          "argv": [
            "/usr/bin/node",
            "--experimental-sqlite",
            "/opt/lingxi-release/current/scripts/release-host/local-control.mjs",
            "/etc/lingxi-release/policy.json",
            "readiness"
          ],
          "timeoutMs": 30000
        },
        "backup": {
          "argv": [
            "/usr/bin/node",
            "--experimental-sqlite",
            "/opt/lingxi-release/current/scripts/release-host/database-tools.mjs",
            "/etc/lingxi-release/policy.json",
            "backup"
          ],
          "timeoutMs": 1800000
        },
        "backupObserve": {
          "argv": [
            "/usr/bin/node",
            "--experimental-sqlite",
            "/opt/lingxi-release/current/scripts/release-host/database-tools.mjs",
            "/etc/lingxi-release/policy.json",
            "backupObserve"
          ],
          "timeoutMs": 1800000
        },
        "restoreVerify": {
          "argv": [
            "/usr/bin/node",
            "--experimental-sqlite",
            "/opt/lingxi-release/current/scripts/release-host/database-tools.mjs",
            "/etc/lingxi-release/policy.json",
            "restoreVerify"
          ],
          "timeoutMs": 1800000
        },
        "restoreVerifyObserve": {
          "argv": [
            "/usr/bin/node",
            "--experimental-sqlite",
            "/opt/lingxi-release/current/scripts/release-host/database-tools.mjs",
            "/etc/lingxi-release/policy.json",
            "restoreVerifyObserve"
          ],
          "timeoutMs": 1800000
        },
        "migrate": {
          "argv": [
            "/usr/bin/node",
            "--experimental-sqlite",
            "/opt/lingxi-release/current/scripts/release-host/database-tools.mjs",
            "/etc/lingxi-release/policy.json",
            "migrate"
          ],
          "timeoutMs": 1800000
        },
        "migrateObserve": {
          "argv": [
            "/usr/bin/node",
            "--experimental-sqlite",
            "/opt/lingxi-release/current/scripts/release-host/database-tools.mjs",
            "/etc/lingxi-release/policy.json",
            "migrateObserve"
          ],
          "timeoutMs": 1800000
        },
        "ingress": {
          "url": "https://release-host-b.example.invalid/ingress",
          "tokenFile": "/run/credentials/lingxi-release-host.service/ingress-executor-token",
          "accessClientIdFile": "/run/credentials/lingxi-release-host.service/access-client-id",
          "accessClientSecretFile": "/run/credentials/lingxi-release-host.service/access-client-secret"
        },
        "ingressState": {
          "url": "https://release-host-b.example.invalid/ingress?target=main-runtime-a",
          "tokenFile": "/run/credentials/lingxi-release-host.service/ingress-executor-token",
          "accessClientIdFile": "/run/credentials/lingxi-release-host.service/access-client-id",
          "accessClientSecretFile": "/run/credentials/lingxi-release-host.service/access-client-secret"
        }
      }
    }
  },
  "database": {
    "container": "REPLACE_WITH_EXISTING_POSTGRES_CONTAINER",
    "user": "REPLACE_WITH_EXISTING_POSTGRES_USER",
    "database": "REPLACE_WITH_EXISTING_DATABASE",
    "profiles": {},
    "migrationHostname": "postgres"
  },
  "acceptedOpsShas": [
    "REPLACE_WITH_EXACT_INSTALLED_OPS_COMMIT_40_HEX"
  ]
}
