              "api": "notebook-rag-v1",
              "worker": "surreal-commands-v1",
              "checkpoint": "notebook-quiescent-commands-v1",
              "control": "notebook-rag-readyz-v1",
              "capabilities": [
                "notebook.rag-schema-v1"
              ]
            },
            "storage": {
