# lingxiloop-server image build context — server runtime + the web SPA bundle.
# The same container serves the API and Web renderer, so
# the build pulls in both the server source and the frontend source. The
# frontend gets compiled in a dedicated multi-stage build inside the
# Dockerfile (full devDeps install, `npm run build`); the result lands as
# /app/dist in the runtime image.
*
!package.json
!package-lock.json
!.npmrc
!server/**
!bin/**
# Frontend sources needed to build the SPA bundle inside the image.
!src/**
# The SPA needs the preview/session/worker and five shared VM inputs. Build
# probes and the already-bundled guest sources are not image inputs.
src/features/cases/cover-vm/**
!src/features/cases/cover-vm/runtime.ts
!src/features/cases/cover-vm/protocol.ts
!src/features/cases/cover-vm/program.ts
!src/features/cases/cover-vm/guest-source.ts
!src/features/cases/cover-vm/svg.ts
!src/features/cases/cover-vm/session.ts
!src/features/cases/cover-vm/worker.ts
!src/features/cases/cover-vm/CaseCoverPreview.tsx
!shared
shared/**
!shared/visualize-public-resources.ts
!public/**
!index.html
!vite.config.ts
!tsconfig.json
!tsconfig.node.json
!postcss.config.js
!tailwind.config.ts
!third_party/zcode/**
!third_party/assistant-ui/streaming-text/**
!third_party/assistant-ui-elements/LICENSE
!third_party/react-chat-elements/reply-message/LICENSE
!scripts/verify-zcode-visualize.mjs
!scripts/build-visualize-runtime.mjs
!scripts/prune-pdfjs-server-runtime.mjs
!scripts/prune-glibc-canvas-runtime.mjs
# Don't bake source maps / built assets / huge logs into the layer.
server/**/*.log
server/**/dist
# Local frontend build outputs — we always rebuild inside the image.
dist
node_modules

# Local dependencies, retired runtime checkouts and test fixtures are not runtime inputs.
server/**/node_modules
server/agent-os
server/src/__tests__
server/src/__integration__
server/**/*.test.ts
src/**/*.test.*
src/**/__tests__
**/node_modules
**/__pycache__
**/.cache
server/**/.env*
server/**/.venv
