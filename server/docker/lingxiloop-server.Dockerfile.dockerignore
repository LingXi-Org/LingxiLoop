# Inputs for the API/worker image and optional legacy SPA build target.
*
!package.json
!package-lock.json
!.npmrc
!server/src/**
!server/package.json
!server/package-lock.json
!server/.npmrc
!server/build/web/package.json
!server/build/web/package-lock.json
!server/scripts/prune-officeparser-runtime.mjs
!server/scripts/check-packaged-startup.mjs
# Frontend sources needed to build the SPA bundle inside the image.
!src/**
# The browser and server share the typed document and operation protocol.
!shared/**
!shared/retired-visualize.ts
!shared/assistant-directive-parser.ts
!shared/artifact-math-source.ts
!shared/design-flow-size.ts
!shared/artifact-editor-origin.ts
!shared/slides-editor-context.ts
!shared/upload-mime.ts
!public/**
!index.html
!vite.config.ts
!tsconfig.json
!tsconfig.node.json
!postcss.config.js
!tailwind.config.ts
!third_party/baoyu-design/**
!third_party/visualize-compat/**
!third_party/assistant-ui/streaming-text/**
!third_party/assistant-ui-elements/LICENSE
!third_party/assistant-ui-with-artifacts/LICENSE
!third_party/react-chat-elements/reply-message/LICENSE
!scripts/prune-pdfjs-server-runtime.mjs
!scripts/prune-glibc-canvas-runtime.mjs
# Don't bake source maps / built assets / huge logs into the layer.
server/**/*.log
server/**/dist
# Local frontend build outputs — we always rebuild inside the image.
dist
node_modules

# Local dependencies, retired runtime checkouts and test fixtures are not runtime inputs.
server/**/node_modules
server/agent-os
server/src/__tests__
server/src/__integration__
server/**/*.test.ts
# Historical migration fixtures and integration runners remain in the repository/CI.
server/fixtures/historical-projection-3.8.2
server/fixtures/historical-runtime-3.8.2.json
server/run-historical-migration-tests.mjs
server/run-integration-tests.mjs
server/integration-suite.mjs
src/**/*.test.*
src/**/__tests__
**/node_modules
**/__pycache__
**/.cache
server/**/.env*
server/**/.venv

shared/**/*.test.ts
