{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lingxiloop-control-plane-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "lingxiloop-control-plane-test",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "ORIGIN_BASE_URL": "https://origin.example.com",
    "OPENSHIP_BASE_URL": "https://openship.example.com",
    "UPTIME_BASE_URL": "https://uptime.example.com",
    "OPENSHIP_PROJECT_IDS": "proj_test-a,proj_test-b",
    "OPENSHIP_IMAGE_TARGETS": "server:proj_test-a:svc_app-a,agent-os:proj_test-a:svc_agent-a,wukongim:proj_test-a:svc_wukong,open-notebook:proj_test-b:svc_notebook,gateway:proj_test-b:svc_gateway",
    "AUTH_ALLOWED_HOSTS": "loop.example.com,admin.example.com",
    "APP_VERSION": "test"
  }
}
