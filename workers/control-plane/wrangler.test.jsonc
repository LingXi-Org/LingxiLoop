{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lingxiloop-control-plane-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "lingxiloop-control-plane-test",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "ORIGIN_BASE_URL": "https://origin.example.com",
    "UPTIME_BASE_URL": "https://uptime.example.com",
    "KOMODO_BASE_URL": "https://ops.example.com",
    "KOMODO_TARGETS_JSON": "{\"lingxiloop-core-state\":{\"stack\":\"lingxiloop-core-state\"},\"lingxiloop-app-a\":{\"stack\":\"lingxiloop-app-a\"},\"server-b-ingress\":{\"stack\":\"server-b-ingress\"},\"lingxiloop-app-b\":{\"stack\":\"lingxiloop-app-b\"},\"lingxiloop-knowledge-agent\":{\"stack\":\"lingxiloop-knowledge-agent\"},\"uptime\":{\"stack\":\"uptime\"}}",
    "MCP_AUTH_USER_ID": "mcp-admin",
    "AUTH_ALLOWED_HOSTS": "loop.example.com,admin.example.com",
    "APP_VERSION": "test"
  }
}
