{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lingxiloop-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "placement": { "mode": "smart" },
  "workers_dev": false,
  "routes": [{ "pattern": "admin.lingxilearn.cn", "custom_domain": true }],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../../dist-admin",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "lingxiloop-control-plane",
    "database_id": "28f39c26-09c6-4e93-91e4-978950e40d0d",
    "migrations_dir": "migrations"
  }],
  "vars": {
    "ORIGIN_BASE_URL": "https://backend.lingxilearn.cn",
    "UPTIME_BASE_URL": "https://uptime.lingxilearn.cn",
    "AUTH_ALLOWED_HOSTS": "loop.lingxilearn.cn,admin.lingxilearn.cn",
    "APP_VERSION": "0.1.0-beta"
  }
}
