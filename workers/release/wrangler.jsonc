{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lingxiloop-release",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "release.lingxilearn.cn", "custom_domain": true }],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "durable_objects": { "bindings": [{ "name": "RELEASES", "class_name": "ReleaseLedger" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReleaseLedger"] }],
  "workflows": [{ "binding": "RELEASE_WORKFLOW", "name": "lingxiloop-release", "class_name": "ReleaseWorkflow" }],
  "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "lingxiloop-releases" }],
  "vars": {
    "ENVIRONMENT": "production",
    "CONTROLLER_OPS_SHA": "UNCONFIGURED",
    "EXECUTORS_JSON": "{}",
    "WORKER_NAMES_JSON": "[\"lingxiloop-web\",\"lingxiloop-control-plane\"]",
    "PROBES_JSON": "{}",
    "BOOTSTRAP_ENABLED": "false"
  }
}
