<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    Hardened-runtime entitlements for the macOS build. The notarize step
    only accepts apps with hardened runtime enabled (we set that in
    package.json's build.mac.hardenedRuntime), which in turn refuses some
    capabilities that Electron's V8 + Node needs unless explicitly granted
    here. We grant the narrow set Electron itself recommends.
  -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- Network access (for talking to api.cumora.ai etc.) -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- OAuth uses the system browser; we don't need to host webviews ourselves. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
