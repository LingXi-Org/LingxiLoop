{
  "schemaVersion": 2, "id": "black-box-smoke", "version": "2",
  "dataset": { "id": "smoke", "version": "1" },
  "samples": 2, "concurrency": 2, "timeoutMs": 120000,
  "graders": [
    { "id": "exact", "kind": "exact", "threshold": 1 },
    { "id": "semantic", "kind": "factuality", "threshold": 0.8 }
  ],
  "gate": { "minScore": 0.9, "minPassRate": 1, "maxScoreDrop": 0.02, "maxCaseDrop": 0.05,
    "maxP95LatencyMs": 120000, "maxCandidateCostCny": 1, "maxJudgeCostCny": 5, "requireBaseline": true }
}
