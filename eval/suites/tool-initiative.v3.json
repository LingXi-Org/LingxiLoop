{
  "schemaVersion": 2,
  "id": "tool-initiative",
  "version": "3",
  "dataset": {
    "id": "tool-initiative",
    "version": "3"
  },
  "samples": 1,
  "concurrency": 1,
  "timeoutMs": 120000,
  "toolBudget": {
    "maxModelCalls": 4,
    "maxToolCalls": 4,
    "maxOutputTokens": 512,
    "maxSampleCostCny": 0.08
  },
  "graders": [
    {
      "id": "initiative",
      "kind": "tool_behavior",
      "dimension": "initiative",
      "threshold": 1
    },
    {
      "id": "completion",
      "kind": "tool_behavior",
      "dimension": "completion",
      "threshold": 1
    },
    {
      "id": "restraint",
      "kind": "tool_behavior",
      "dimension": "restraint",
      "threshold": 1
    },
    {
      "id": "efficiency",
      "kind": "tool_behavior",
      "dimension": "efficiency",
      "threshold": 1
    }
  ],
  "gate": {
    "minScore": 1,
    "minPassRate": 1,
    "maxScoreDrop": 0.02,
    "maxCaseDrop": 0,
    "maxP95LatencyMs": 120000,
    "maxCandidateCostCny": 0.48,
    "maxJudgeCostCny": 0,
    "requireBaseline": true
  }
}
