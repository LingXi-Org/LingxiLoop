# Candidate: production model under evaluation. Fill in keys and CNY pricing.
EVAL_CANDIDATE_BASE_URL=https://api.siliconflow.cn/v1
EVAL_CANDIDATE_MODEL=deepseek-ai/DeepSeek-V4-Flash
EVAL_CANDIDATE_API_KEY=
EVAL_CANDIDATE_INPUT_CNY_PER_MILLION=
EVAL_CANDIDATE_OUTPUT_CNY_PER_MILLION=
EVAL_CANDIDATE_MAX_TOKENS=1536
EVAL_CANDIDATE_TIMEOUT_MS=60000

# Judge: independent model. To reuse the provider key, explicitly fill this key too.
EVAL_JUDGE_BASE_URL=https://api.siliconflow.cn/v1
EVAL_JUDGE_MODEL=Pro/moonshotai/Kimi-K2.6
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_INPUT_CNY_PER_MILLION=6.5
EVAL_JUDGE_OUTPUT_CNY_PER_MILLION=27
EVAL_JUDGE_MAX_TOKENS=512
EVAL_JUDGE_TIMEOUT_MS=180000
# Optional SiliconFlow field; omit for providers that do not support it.
EVAL_JUDGE_ENABLE_THINKING=false

# Optional independent Jev Judge. No fallback to runtime TYPESAFE_API_KEY.
EVAL_JUDGE_PROVIDER=autoevals
EVAL_JEV_API_KEY=
EVAL_JEV_MODEL=jev-1.13.0
EVAL_JEV_INPUT_CNY_PER_MILLION=
EVAL_JEV_TIMEOUT_MS=10000
# Set EVAL_JUDGE_PROVIDER=jev to opt in; create a NEW baseline for its fingerprint.
