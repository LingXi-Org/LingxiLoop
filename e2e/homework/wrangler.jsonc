{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lingxiloop-homework-control-e2e",
  "main": "../../workers/control-plane/src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "lingxiloop-homework-control-e2e",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "../../workers/control-plane/migrations"
  }],
  "vars": {
    "ORIGIN_BASE_URL": "http://127.0.0.1:53196",
    "UPTIME_BASE_URL": "http://127.0.0.1:9",
    "KOMODO_BASE_URL": "http://127.0.0.1:9",
    "KOMODO_TARGETS_JSON": "{}",
    "AUTH_ALLOWED_HOSTS": "127.0.0.1:53198,127.0.0.1:8798,localhost:53198,localhost:8798",
    "APP_VERSION": "e2e-homework",
    "BETTER_AUTH_SECRET": "lingxiloop-homework-local-auth-secret-000000001",
    "GATEWAY_HMAC_SECRET": "lingxiloop-homework-live-gateway-secret",
    "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
  }
}
